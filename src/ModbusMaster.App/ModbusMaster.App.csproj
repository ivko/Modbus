<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ModbusMaster.Core\ModbusMaster.Core.csproj" />
    <ProjectReference Include="..\ModbusMaster.Ui\ModbusMaster.Ui.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ModbusMaster</AssemblyName>
    <RootNamespace>ModbusMaster.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Product>Modbus Master</Product>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\docs\manual\**\*" LinkBase="manual" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\**\*" LinkBase="examples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
